# Copy to secrets.local.env (gitignored) and fill in real values.
# Or export these in your shell before deploy/publish scripts.

# Hosting SSH / FTP (agent.assistix.org / ISPManager / id.assistix.org)
BP=YOUR_SSH_PASSWORD_HERE
ASSISTIX_SSH_PASS=YOUR_SSH_PASSWORD_HERE
ASSISTIX_FTP_PASS=YOUR_FTP_PASSWORD_HERE

# Desktop update publish API token
BEAM_UPDATE_TOKEN=YOUR_UPDATE_TOKEN_HERE

# Server-only: Assistix LLM Gateway → Kumorouter (never ship in desktop)
# KUMO_API_KEY=YOUR_KUMO_API_KEY_HERE
# Desktop talks to https://agent.assistix.org/llm (or ASSISTIX_LLM_BASE) with Assistix ID.

# ASSISTIX ID OAuth (local bridge)
ASSISTIX_OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET_HERE

# Optional code signing
# BEAM_SIGN_PFX=C:\path\to\cert.pfx
# BEAM_SIGN_PFX_PASSWORD=
# BEAM_SIGN_THUMBPRINT=
